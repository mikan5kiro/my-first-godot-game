[node name="DeskArea" type="Area2D" parent="." unique_id=605630984]
script = ExtResource("6_item")
message = "我的办公桌。
@可以在这里做喜欢的事情，很让人安心的角落呢。
@要是做自己喜欢的事情可以赚钱就好了。
@可以的话，真的再也不想上班了。
@……但是，我真的有能赚到钱的技能吗？"
